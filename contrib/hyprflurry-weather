#!/usr/bin/env bash
# hyprflurry-weather: make hyprflurry follow the real weather.
#
# Every INTERVAL seconds this fetches the current conditions from Open-Meteo
# (free, no API key) and writes a config made of your normal hyprflurry.conf
# plus weather-derived overrides. hyprflurry reloads it live, so the snow
# thickens, thins, changes shape and follows the wind without restarting,
# and the piles stay put. When it isn't snowing, flakes = 0 and the piles
# melt away at your configured rate (faster above freezing).
#
# usage: LAT=43.65 LON=-79.38 hyprflurry-weather [--dry-run]
#   --dry-run  print the generated overrides once and exit
#
# environment:
#   LAT, LON   your location in decimal degrees (required; west/south are negative)
#   INTERVAL   seconds between checks (default 1800)
#   BASE       your config (default ~/.config/hypr/hyprflurry.conf)
#   OUT        generated config (default ~/.cache/hyprflurry/hyprflurry.conf)
#
# needs: curl, jq

set -u

: "${LAT:?set LAT to your latitude}"
: "${LON:?set LON to your longitude}"
INTERVAL=${INTERVAL:-1800}
BASE=${BASE:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprflurry.conf}
OUT=${OUT:-${XDG_CACHE_HOME:-$HOME/.cache}/hyprflurry/hyprflurry.conf}

URL="https://api.open-meteo.com/v1/forecast?latitude=$LAT&longitude=$LON&current=weather_code,snowfall,temperature_2m,wind_speed_10m,wind_direction_10m,wind_gusts_10m&wind_speed_unit=kmh"

# Open-Meteo "current" JSON -> hyprflurry config lines.
#   weather_code (WMO): 71/73/75 snow light/moderate/heavy, 77 snow grains,
#                       85/86 snow showers light/heavy
#   wind_direction is where the wind comes FROM; on screen, wind from the
#   west blows flakes to the right (positive `wind`).
read -r -d '' MAP <<'JQ'
.current as $c
| def clamp(a; b): if . < a then a elif . > b then b else . end;
  def r2: . * 100 | round / 100;
  ({ "71": 150, "73": 400, "75": 900, "77": 120, "85": 250, "86": 900 }[$c.weather_code | tostring] // 0) as $base
| ($c.snowfall // 0) as $fall
| ($c.temperature_2m) as $t
| (if $base > 0 then ($base + $fall * 150 | clamp(80; 1500) | floor) else 0 end) as $flakes
| "# generated by hyprflurry-weather from weather code \($c.weather_code), \($t) °C, wind \($c.wind_speed_10m) km/h from \($c.wind_direction_10m)°",
  "flakes = \($flakes)",
  "pile_rate = \($flakes / 300 | clamp(0.2; 4) | r2)",
  "wind = \(-($c.wind_direction_10m * 3.14159265 / 180 | sin) * $c.wind_speed_10m / 30 | clamp(-2; 2) | r2)",
  "gust = \(($c.wind_gusts_10m - $c.wind_speed_10m) / 30 | clamp(0.05; 1.5) | r2)",
  if $c.weather_code == 77 then
    "style = soft", "min_size = 0.8", "max_size = 2.2", "speed = 1.1", "sway = 0.4"
  elif $t > -2 then
    "style = soft", "max_size = 6.5", "speed = 1.3", "sway = 0.7"
  elif $t < -10 then
    "style = crystal", "max_size = 3.5", "speed = 0.7", "sway = 1.3"
  else
    "style = mixed"
  end,
  if $t > 0 then "pile_melt = \(0.3 * $t | clamp(0.05; 5) | r2)" else empty end
JQ

overrides() {
    local json
    json=$(curl -sf --max-time 20 "$URL") || { echo "hyprflurry-weather: weather fetch failed" >&2; return 1; }
    jq -r "$MAP" <<<"$json" || { echo "hyprflurry-weather: unexpected response" >&2; return 1; }
}

update() {
    local o
    o=$(overrides) || return 1 # keep the current snow on errors
    mkdir -p "${OUT%/*}"
    { [[ -f $BASE ]] && cat "$BASE"; printf '\n%s\n' "$o"; } >"$OUT.tmp"
    # replace atomically, and only on change: every reload restyles the flakes
    if cmp -s "$OUT.tmp" "$OUT"; then
        rm -f "$OUT.tmp"
    else
        mv "$OUT.tmp" "$OUT"
    fi
}

if [[ ${1:-} == --dry-run ]]; then
    overrides
    exit
fi

mkdir -p "${OUT%/*}"
pid=
trap '[[ -n $pid ]] && kill "$pid" 2>/dev/null; exit' INT TERM EXIT

# start with whatever we have if the first fetch fails
update || { [[ -f $OUT ]] || cp "$BASE" "$OUT" 2>/dev/null || : >"$OUT"; }

hyprflurry -c "$OUT" &
pid=$!

while kill -0 "$pid" 2>/dev/null; do
    sleep "$INTERVAL" &
    wait $! # lets the trap fire immediately
    update
done
